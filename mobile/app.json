{
  "expo": {
    "name": "FitCircle",
    "slug": "fitcircle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitcircle",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "co.fitcircle.app",
      "supportsTablet": false
    },
    "android": {
      "package": "co.fitcircle.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "FitCircle uses the camera so you can take same-day photo or video proof of your workout.",
          "photosPermission": "FitCircle lets you pick a photo or video you took today as workout proof.",
          "microphonePermission": "FitCircle records sound with video proof."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
